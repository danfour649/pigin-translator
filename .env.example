# Copy to .env.local and set one credential. Never commit real keys, and never
# prefix these with NEXT_PUBLIC_ — the browser must not see them.
#
# On Vercel you can leave every key empty. Enable AI Gateway for the project
# and the server uses OIDC (VERCEL_OIDC_TOKEN) with no key in the repo.
# Locally, `vercel link` then `vercel env pull` writes that token into .env.local.

# Vercel AI Gateway. Used first when set.
AI_GATEWAY_API_KEY=

# Direct provider fallbacks, used when the gateway is not configured, when
# gateway authentication fails, or when every free-tier gateway model is
# restricted and the next key is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
